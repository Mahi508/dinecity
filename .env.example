# Used by docker compose (the database container)
DB_NAME=dinecity
DB_USER=dinecity
DB_PASSWORD=dinecity

# Read by the Spring Boot backend from the environment (NOT from this file automatically).
# Set them in your terminal before `mvn spring-boot:run`, or leave the defaults for local development.
DB_URL=jdbc:postgresql://localhost:5432/dinecity
JWT_SECRET=replace-with-at-least-32-random-characters
DINECITY_ADMIN_EMAIL=
DINECITY_ADMIN_PASSWORD=
DINECITY_AUTO_APPROVE=true
